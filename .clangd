If:                               # Apply this config conditionally
  PathMatch: .*\.cppm       # to all cppm
CompileFlags:
  Add: [-xc++-module, -fcxx-modules, -std=c++20, -fmodules]
  CompilationDatabase: '/home/x-ray/build/Qt_6_10_1_opt_gcc_15-littlexml/Debug'

Diagnostics:
  ClangTidy:
    Add:
      - modernize-*
      - performance-*
      - readability-*

#  Add: #[
#    - -fcxx-modules
#    - -fmodules
#    - -fimplicit-modules
#    # - -fimplicit-module-maps
#    # "-fmodules-cache-path=build/modules-cache
#    # "-I", "include"
#    #]

